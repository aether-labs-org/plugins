# Gate budgets in seconds, and the thresholds of harness-check. Edit here; see .agents/README.md.
CEILING_SECONDS=30
SLOW_CEILING_SECONDS=600

# Plans untouched for this many days are stale (harness-check: plan-stale).
PLAN_STALE_DAYS=30
# .agents/progress.md over this many lines warns (harness-check: progress-size).
PROGRESS_MAX_LINES=200
