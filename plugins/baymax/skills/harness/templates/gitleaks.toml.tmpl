# .gitleaks.toml - written by the Baymax harness skill; edit it only with an ADR (the secrets script lists it in config:).
#
# gitleaks scans every file under the path, git-ignored ones included (node_modules aside, which its default rules skip): build
# output, virtualenvs, local worktrees, generated code. It has no option to honour .gitignore, so each ignored directory is
# allow-listed here, one entry per directory that `scripts/discover.sh` reports as `ignored-dir`. Never allow-list a directory that
# holds tracked files, and never use a pattern broader than the directory.
#
# Without `useDefault = true` the default rules are lost and the scan finds nothing, silently.
# Entries are regular expressions matched against the path from the repository root: escape dots (\.claude/worktrees/).
# [[allowlists]] is verified on gitleaks 8.30.1; the older [allowlist] table is accepted there as well.
[extend]
useDefault = true

[[allowlists]]
description = "git-ignored directories (gitleaks cannot read .gitignore)"
paths = [
  '''(^|/)<ignored-dir>/''',
]
