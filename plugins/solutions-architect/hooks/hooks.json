{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|mcp__.*run_script.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/deny_mutations.py\"",
            "timeout": 5
