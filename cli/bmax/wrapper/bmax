#!/bin/sh
# bmax wrapper (Baymax). Runs the bmax binary pinned by bmax.lock: downloads it once into a
# per-user, per-version cache, verifies its sha256 and execs it. POSIX sh, no bashisms.
#
#   sh .agents/bin/bmax <command>        in a repository (the lock is .agents/bmax.lock)
#   sh bmax/bin/bmax <command>           in the Baymax plugin (the lock is bmax/bmax.lock)
#
# BMAX_BINARY=<path>    use this binary instead of the cache (still verified against the lock)
# BMAX_RELEASE_URL=<u>  download <u>/bmax-<os>-<arch> instead of the GitHub release (a mirror)
#
# BMAX_ROOT: in a repository the wrapper exports BMAX_ROOT=<the repository>, so that bmax works on the repository the
# wrapper belongs to and not on whatever repository the working directory happens to be in (an agent session can
# cd into a nested repository or a worktree). The plugin's copy unsets it: there the repository is the working
# directory's.
# BMAX_ROOT is only this hand-off: bmax does not pass it on to the scripts and commands it runs. (Nor the git
# variables a git hook exports to tie commands to one repository: GIT_DIR, GIT_INDEX_FILE and the like.)
#
# In hook mode (bmax hook ...) the wrapper never downloads. Without a verified binary it
# answers by itself, so that the agent's protection does not silently disappear.
set -eu

die() {
  printf 'bmax: %s\n' "$1" >&2
  exit 3
}

# refuse MESSAGE: in hook mode answer (naming the cause), otherwise die with the message
refuse() {
  unavailable_why=$1
  [ "$hook_mode" = 1 ] && answer_unavailable
  die "$1"
}

self_dir=$(cd "$(dirname "$0")" && pwd)
lock="$self_dir/../bmax.lock"

hook_mode=0
hook_event=${2:-}
[ "${1:-}" = hook ] && hook_mode=1

# The root of the commands: the repository this wrapper belongs to (.agents/bin/bmax), never an inherited value.
case "$self_dir" in
  */.agents/bin)
    BMAX_ROOT=$(cd "$self_dir/../.." && pwd)
    export BMAX_ROOT
    ;;
  *) unset BMAX_ROOT ;;
esac

# What to tell the human to run. In a repository the wrapper is .agents/bin/bmax; the plugin carries its own copy
# elsewhere (bmax/bin/bmax), where .agents/bin does not exist, so name this wrapper's own path.
case "$self_dir" in
  */.agents/bin) setup_cmd='sh .agents/bin/bmax setup' ;;
  *) setup_cmd="sh $self_dir/$(basename "$0") version" ;;
esac
# Why the hook cannot be answered by bmax itself. Default: bmax is not cached yet, which the command fixes. Each other
# failure names its own cause (a missing lock is not fixed by setup).
unavailable_why="run $setup_cmd"

# answer_unavailable: hook mode without a verified bmax (spec section 9.5).
answer_unavailable() {
  # the message goes into JSON: escape backslashes and double quotes
  why_json=$(printf '%s' "$unavailable_why" | sed 's/\\/\\\\/g; s/"/\\"/g')
  unavailable_msg="bmax unavailable: $unavailable_why"
  unavailable_msg_json="bmax unavailable: $why_json"
  case "$hook_event" in
    pre-tool-use)
      payload=$(cat 2>/dev/null || true)
      kind=ask
      if printf '%s' "$payload" | grep -Eq '"permission_mode"[[:space:]]*:[[:space:]]*"(bypassPermissions|dontAsk)"'; then
        kind=deny
      fi
      printf '{"hookSpecificOutput":{"hookEventName":"PreToolUse","permissionDecision":"%s","permissionDecisionReason":"%s"},"permissionDecision":"%s","permissionDecisionReason":"%s"}\n' \
        "$kind" "$unavailable_msg_json" "$kind" "$unavailable_msg_json"
      ;;
    stop)
      printf '{"systemMessage":"bmax unavailable: the gates did not run - %s"}\n' "$why_json"
      ;;
    *)
      printf 'bmax: %s\n' "$unavailable_msg" >&2
      ;;
  esac
  exit 0
}

if [ ! -f "$lock" ]; then
  refuse "no bmax.lock beside $self_dir (expected $lock)"
fi

lock_get() {
  sed -n "s/^$1=//p" "$lock" | head -n 1 | tr -d '\r'
}

version=$(lock_get version)
[ -n "$version" ] || refuse "bmax.lock has no version="

os=$(uname -s | tr 'ABCDEFGHIJKLMNOPQRSTUVWXYZ' 'abcdefghijklmnopqrstuvwxyz')
case "$os" in
  linux | darwin) ;;
  *) refuse "unsupported operating system: $os (Linux and macOS; Windows through WSL)" ;;
esac
arch=$(uname -m)
case "$arch" in
  x86_64 | amd64) arch=amd64 ;;
  aarch64 | arm64) arch=arm64 ;;
  *) refuse "unsupported architecture: $arch" ;;
esac

want=$(lock_get "$os-$arch")
[ -n "$want" ] || refuse "bmax.lock has no $os-$arch= line"

if [ "$os" = darwin ]; then
  cache_root="${HOME:-/tmp}/Library/Caches/bmax"
else
  cache_root="${XDG_CACHE_HOME:-${HOME:-/tmp}/.cache}/bmax"
fi
cache_dir="$cache_root/$version"
cached="$cache_dir/bmax"

sha_of() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" | cut -d ' ' -f 1
  elif command -v shasum >/dev/null 2>&1; then
    shasum -a 256 "$1" | cut -d ' ' -f 1
  else
    return 1
  fi
}

# verified FILE: true when FILE exists and its sha256 equals the lock.
verified() {
  [ -f "$1" ] || return 1
  got=$(sha_of "$1") || return 1
  [ "$got" = "$want" ]
}

# 1. BMAX_BINARY, verified like a download.
if [ -n "${BMAX_BINARY:-}" ]; then
  if verified "$BMAX_BINARY"; then
    exec "$BMAX_BINARY" "$@"
  fi
  refuse "checksum mismatch for $BMAX_BINARY"
fi

# 2. The cache.
if [ -f "$cached" ]; then
  if verified "$cached"; then
    [ -x "$cached" ] || chmod +x "$cached" 2>/dev/null || true
    exec "$cached" "$@"
  fi
  refuse "checksum mismatch for $cached (delete it, then run $setup_cmd)"
fi

# 3. Download (never in hook mode).
[ "$hook_mode" = 1 ] && answer_unavailable

url="${BMAX_RELEASE_URL:-https://github.com/aether-labs-org/plugins/releases/download/cli/bmax/v$version}/bmax-$os-$arch"
mkdir -p "$cache_dir" || die "cannot create $cache_dir"
tmp=$(mktemp "$cache_dir/bmax.XXXXXX") || die "cannot create a temporary file in $cache_dir"
trap 'rm -f "$tmp"' EXIT HUP INT TERM
if command -v curl >/dev/null 2>&1; then
  curl -fsSL -o "$tmp" "$url" || die "cannot download $url"
elif command -v wget >/dev/null 2>&1; then
  wget -q -O "$tmp" "$url" || die "cannot download $url"
else
  die "neither curl nor wget is available to download $url"
fi
verified "$tmp" || die "checksum mismatch for $url"
chmod +x "$tmp"
mv "$tmp" "$cached"
trap - EXIT HUP INT TERM
exec "$cached" "$@"
